{
  "name": "doc-kit",
  "version": "0.0.1",
  "description": "마크다운 문서를 블록 단위 트리로 구조화하고 내용 주소로 인덱싱해 저작·검증·질의하는 도구",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "check": "tsx src/cli/bin.ts check rules",
    "index": "tsx src/cli/bin.ts index rules --out .dockit/out",
    "render": "tsx src/cli/bin.ts render rules --out .dockit/site",
    "store": "tsx src/cli/bin.ts store rules",
    "log": "tsx src/cli/bin.ts log rules",
    "gc": "tsx src/cli/bin.ts gc rules"
  },
  "dependencies": {
    "hast-util-to-html": "^9.0.5",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "bin": {
    "dockit": "./dist/cli/bin.js"
  }
}
